{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winter-arc",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "winter-arc",
      "database_id": "38dcfa3a-e76d-427b-a500-7e55612c7da4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
